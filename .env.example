# Anthropic API key for Claude LLM
ANTHROPIC_API_KEY=your-api-key-here

# Optional: Claude model (alias). Override to a pinned version if desired.
CLAUDE_MODEL=claude-opus-4-8

# Optional: Default Whisper model (tiny, base, small, medium, large-v3)
# WHISPER_MODEL=medium

# Managed transcription-only workflow (no publishing calls)
ASSEMBLYAI_API_KEY=
DEEPGRAM_API_KEY=
# Conservative admission reservations in USD/source hour, not observed billing
TRANSCRIPTION_PRIMARY_RESERVATION_PER_HOUR=1.50
TRANSCRIPTION_BACKUP_RESERVATION_PER_HOUR=1.50
